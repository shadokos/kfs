diff --color -ru a/gcc/config.gcc b/gcc/config.gcc
--- a/gcc/config.gcc	2026-09-08 15:30:12.429147584 +0200
+++ b/gcc/config.gcc	2026-09-08 15:30:33.556817778 +0200
@@ -1094,6 +1094,14 @@
 *-*-rdos*)
   use_gcc_stdint=wrap
   ;;
+*-*-shadokos*)
+  extra_options="$extra_options gnu-user.opt" # enable options like -pthread
+  gas=yes # using gnu gas
+  gnu_ld=yes # using gnu ld
+  default_use_cxa_atexit=yes # __cxa_atexit exists
+  use_gcc_stdint=provide # we want stdint.h from gcc
+  thread_file='posix' # using pthreads
+  ;;
 *-*-solaris2*)
   # i?86-*-solaris2* needs to insert headers between cpu default and
   # Solaris 2 specific ones.
@@ -1236,6 +1244,9 @@
 esac
 
 case ${target} in
+i[34567]86-*-shadokos*)
+	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h glibc-stdint.h shadokos.h gnu-user.h" # config files for headers (defines such as _GNU_USER or __shadokos__)
+;;
 aarch64*-*-elf | aarch64*-*-fuchsia* | aarch64*-*-rtems*)
 	tm_file="${tm_file} elfos.h newlib-stdint.h"
 	tm_file="${tm_file} aarch64/aarch64-elf.h aarch64/aarch64-errata.h aarch64/aarch64-elf-raw.h"
