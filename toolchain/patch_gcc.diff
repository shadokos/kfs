--- /dev/null
+++ b/gcc/config/shadokos.h
@@ -0,0 +1,27 @@
+#define LD_EMUL_SUFFIX /* append to the linker emulation mode */ \
+  "%{mabi=sysv}"
+
+#define GNU_USER_LINK_EMULATION "elf64sysv" /* how to link */
+
+#undef LIB_SPEC
+#define LIB_SPEC "-lc" /* link with libc by default */
+
+#undef LINK_SPEC
+#define LINK_SPEC "%{shared:-shared} %{static:-static} %{!shared: %{!static: %{rdynamic:-export-dynamic}}} %{!dynamic-linker:-dynamic-linker /usr/lib/ld.so}" /* define rules for building static and shared programs */
+
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "%{!shared:crt1.o%s} crti.o%s %{shared:crtbeginS.o%s;:crtbegin.o%s}" /* these are passed at the start of the link command */
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC "%{shared:crtendS.o%s;:crtend.o%s} crtn.o%s" /* these are passed at the end of the link command */
+
+#undef TARGET_OS_CPP_BUILTINS /* builtin defines for our target */
+#define TARGET_OS_CPP_BUILTINS()      \
+  do {                                \
+    builtin_define ("__shadokos__");      \
+    builtin_define ("__mlibc__");      \
+    builtin_define ("__unix__");      \
+    builtin_assert ("system=shadokos");   \
+    builtin_assert ("system=unix");   \
+    builtin_assert ("system=posix");   \
+  } while(0);
